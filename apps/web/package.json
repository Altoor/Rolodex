{
  "name": "web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001 & pnpm run sleep3s && pnpm run codegen",
    "sleep3s": "node -e \"setTimeout(() => process.exit(0), 3000)\"",
    "codegen": "graphql-codegen --config codegen.ts --watch",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "^4.3.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@repo/ui": "workspace:*",
    "geist": "1.7.2",
    "graphql": "^16.14.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.5",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@next/eslint-plugin-next": "16.3.6",
    "@parcel/watcher": "^2.6.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}