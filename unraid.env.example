# Copy this file to .env beside compose.unraid.yml.

# Unraid data root. Postgres, uploads, and Ollama models live here.
ROLODEX_DATA_DIR=/mnt/user/appdata/rolodex

# Images published by .github/workflows/publish-images.yml.
# Use the lower-case GitHub owner or organization that published them.
ROLODEX_IMAGE_PREFIX=ghcr.io/altoor
# Pin a sha-... or v... tag for reproducible updates; latest tracks main.
ROLODEX_TAG=latest

# 127.0.0.1 when using Tailscale Serve (recommended).
# 0.0.0.0 for direct access over plain tailnet ports.
ROLODEX_BIND_ADDR=127.0.0.1

# These are only used when Postgres first initializes the database. Changing
# them later requires resetting or manually migrating the database.
POSTGRES_USER=rolo
POSTGRES_DB=rolo
# Use a URL-safe value (hex is easiest): openssl rand -hex 16
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-16

# openssl rand -hex 32
TOKEN_SECRET=replace-with-openssl-rand-hex-32
AUTH_TOKEN_TTL_SECONDS=604800

# Tailscale Serve URLs. Use http://<host>:3001 and :4000 for direct mode.
API_PUBLIC_ORIGIN=https://unraid.YOURTAILNET.ts.net:8443
API_CORS_ORIGINS=https://unraid.YOURTAILNET.ts.net

# Starts the bundled Ollama container (compose.unraid.yml profile "ollama").
# Remove this line to skip it and use your own server via OLLAMA_BASE_URL.
COMPOSE_PROFILES=ollama
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
